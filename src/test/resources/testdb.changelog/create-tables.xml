<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!--    TABLE ROLE-->
    <changeSet id="3" author="LittleBlBb">
        <createTable tableName="roles">
            <column name="role_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4" author="Bagdad1970">
        <createTable tableName="album_types">
            <column name="album_type_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


<!--        TABLE USER-->
    <changeSet id="5" author="LittleBlBb">
        <createTable tableName="users">
            <column name="user_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

<!--        TABLE PLAYLIST-->
    <changeSet id="6" author="LittleBlBb">
        <createTable tableName="playlists">
            <column name="playlist_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="playlist_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="is_system" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!--        TABLE ALBUM-->

    <changeSet id="7" author="LittleBlBb">
        <createTable tableName="albums">
            <column name="album_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="album_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="cover_filepath" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="released_at" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


<!--        TABLE AUTHOR-->
    <changeSet id="8" author="LittleBlBb">
        <createTable tableName="authors">
            <column name="author_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="photo_filepath" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>


<!--        TABLE TRACK-->
    <changeSet id="9" author="LittleBlBb">
        <createTable tableName="tracks">
            <column name="track_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="track_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="genre_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="audio_filepath" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="cover_filepath" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="10" author="Bagdad1970">
        <createTable tableName="genres">
            <column name="genre_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


<!--        JOIN TABLES-->

<!--        TABLE FAVORITE_ALBUMS-->
    <changeSet id="11" author="LittleBlBb">
        <createTable tableName="favorite_albums">
            <column name="album_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
        </createTable>
    </changeSet>


    <!--        TABLE TRACK_OF_PLAYLIST-->
    <changeSet id="12" author="LittleBlBb">
        <createTable tableName="track_of_playlist">
            <column name="playlist_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="track_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
        </createTable>
    </changeSet>

<!--        TABLE TRACK_OF_ALBUM-->
    <changeSet id="13" author="LittleBlBb">
        <createTable tableName="track_of_album">
            <column name="track_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="album_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
        </createTable>
    </changeSet>

<!--        TABLE AUTHOR_OF_ALBUM-->

    <changeSet id="14" author="LittleBlBb">
        <createTable tableName="author_of_album">
            <column name="author_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="album_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
        </createTable>
    </changeSet>

<!--        TABLE AUTHOR_OF_TRACK-->

    <changeSet id="15" author="LittleBlBb">
        <createTable tableName="author_of_track">
            <column name="author_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="track_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
        </createTable>
    </changeSet>

<!--        TABLE FAVORITE_TRACKS-->
    <changeSet id="16" author="LittleBlBb">
        <createTable tableName="favorite_tracks">
            <column name="track_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
        </createTable>
    </changeSet>

<!--CONSTRAINTS-->
    <changeSet id="17" author="LittleBlBb">
        <!--        CONSTRAINT FK_FAVORITE_TRACKS_TRACK-->

        <addForeignKeyConstraint 
                                 baseTableName="favorite_tracks"
                                 baseColumnNames="track_id"
                                 constraintName="fk_favorite_tracks_track"
                                 referencedTableName="tracks"
                                 referencedColumnNames="track_id"/>

        <!--        CONSTRAINT FK_FAVORITE_TRACKS_USER-->

        <addForeignKeyConstraint 
                                 baseTableName="favorite_tracks"
                                 baseColumnNames="user_id"
                                 constraintName="fk_favorite_tracks_user"
                                 
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"/>

        <!--        CONSTRAINT FK_FAVORITE_ALBUMS_ALBUM-->

        <addForeignKeyConstraint 
                                 baseTableName="favorite_albums"
                                 baseColumnNames="album_id"
                                 constraintName="fk_favorite_albums_album"
                                 
                                 referencedTableName="albums"
                                 referencedColumnNames="album_id"/>

        <!--        CONSTRAINT FK_FAVORITE_ALBUMS_USER-->

        <addForeignKeyConstraint 
                                 baseTableName="favorite_albums"
                                 baseColumnNames="user_id"
                                 constraintName="fk_favorite_albums_user"
                                 
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"/>
        <!--        CONSTRAINT FK_AUTHOR_OF_TRACK_AUTHOR-->

        <addForeignKeyConstraint 
                                 baseTableName="author_of_track"
                                 baseColumnNames="author_id"
                                 constraintName="fk_author_of_track_author"
                                 
                                 referencedTableName="authors"
                                 referencedColumnNames="author_id"/>

        <!--        CONSTRAINT FK_AUTHOR_OF_TRACK_TRACK-->

        <addForeignKeyConstraint 
                                 baseTableName="author_of_track"
                                 baseColumnNames="track_id"
                                 constraintName="fk_author_of_track_track"
                                 
                                 referencedTableName="tracks"
                                 referencedColumnNames="track_id"/>

        <!--        CONSTRAINT FK_AUTHOR_OF_ALBUM_AUTHOR-->

        <addForeignKeyConstraint 
                                 baseTableName="author_of_album"
                                 baseColumnNames="author_id"
                                 constraintName="fk_author_of_album_author"
                                 
                                 referencedTableName="authors"
                                 referencedColumnNames="author_id"/>

        <!--        CONSTRAINT FK_AUTHOR_OF_ALBUM_ALBUM-->

        <addForeignKeyConstraint 
                                 baseTableName="author_of_album"
                                 baseColumnNames="album_id"
                                 constraintName="fk_author_of_album_album"
                                 
                                 referencedTableName="albums"
                                 referencedColumnNames="album_id"/>

        <!--        CONSTRAINT FK_TRACK_OF_ALBUM_TRACK-->

        <addForeignKeyConstraint 
                                 baseTableName="track_of_album"
                                 baseColumnNames="track_id"
                                 constraintName="fk_track_of_album_track"
                                 
                                 referencedTableName="tracks"
                                 referencedColumnNames="track_id"/>

        <!--        CONSTRAINT FK_TRACK_OF_ALBUM_ALBUM-->

        <addForeignKeyConstraint 
                                 baseTableName="track_of_album"
                                 baseColumnNames="album_id"
                                 constraintName="fk_track_of_album_album"
                                 
                                 referencedTableName="albums"
                                 referencedColumnNames="album_id"/>

        <!--        CONSTRAINT TRACK_OF_PLAYLIST_PLAYLIST-->

        <addForeignKeyConstraint 
                                 baseTableName="track_of_playlist"
                                 baseColumnNames="playlist_id"
                                 constraintName="fk_track_of_playlist_playlist"
                                 
                                 referencedTableName="playlists"
                                 referencedColumnNames="playlist_id"/>

        <!--        CONSTRAINT TRACK_OF_PLAYLIST_TRACK-->

        <addForeignKeyConstraint 
                                 baseTableName="track_of_playlist"
                                 baseColumnNames="track_id"
                                 constraintName="fk_track_of_playlist_track"
                                 
                                 referencedTableName="tracks"
                                 referencedColumnNames="track_id"/>


        <!--        CONSTRAINT FK_PLAYLIST_USER-->

        <addForeignKeyConstraint 
                                 baseTableName="playlists"
                                 baseColumnNames="user_id"
                                 constraintName="fk_playlist_user"
                                 
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"/>

        <!--        CONSTRAINT FK_USER_ROLE-->

        <addForeignKeyConstraint 
                                 baseTableName="users"
                                 baseColumnNames="role_id"
                                 constraintName="fk_user_role"
                                 
                                 referencedTableName="roles"
                                 referencedColumnNames="role_id"/>

        <!--        CONSTRAINT FK_USER_ROLE-->

        <addForeignKeyConstraint 
                                 baseTableName="tracks"
                                 baseColumnNames="genre_id"
                                 constraintName="fk_track_genre"
                                 
                                 referencedTableName="genres"
                                 referencedColumnNames="genre_id"/>

        <!--        CONSTRAINT FK_USER_ROLE-->

        <addForeignKeyConstraint 
                                 baseTableName="albums"
                                 baseColumnNames="album_type_id"
                                 constraintName="fk_album_album_type"
                                 
                                 referencedTableName="album_types"
                                 referencedColumnNames="album_type_id"/>


    </changeSet>
</databaseChangeLog>